{
  "name": "fin-tastic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A rarest-answer trivia game. Name the uncommon answer and sink to the trench floor.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "validate": "node --experimental-strip-types scripts/validate-data.mjs",
    "show": "node --experimental-strip-types scripts/show-prompt.mjs",
    "wikidata:search": "node scripts/wikidata/search.mjs",
    "wikidata:fetch": "node scripts/wikidata/fetch.mjs",
    "wikidata:audit": "node --experimental-strip-types scripts/wikidata/audit.mjs",
    "wikidata:calibrate": "node --experimental-strip-types scripts/wikidata/calibrate.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
